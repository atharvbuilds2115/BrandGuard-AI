DATABASE_URL=sqlite:///./brandguard.db
UPLOAD_DIR=
MAX_UPLOAD_SIZE_MB=10
# Choose one server-side AI provider. Defaults to Gemini when omitted.
AI_PROVIDER=gemini
# Keep all provider keys server-side; never use VITE_ variables for them.
GEMINI_API_KEY=
GEMINI_PRIMARY_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
# GEMINI_MODEL remains supported as the legacy primary-model setting.
GROQ_API_KEY=
GROQ_TEXT_MODEL=qwen/qwen3.8-27b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Must match VITE_FIREBASE_PROJECT_ID and the configured Admin credential project.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Exact Firebase email allowed to receive the isolated, labeled evaluator sample workspace.
DEMO_ACCOUNT_EMAIL=
DEMO_CREATOR_EMAIL=
DEMO_CREATOR_PASSWORD=
DEMO_REVIEWER_EMAIL=
DEMO_REVIEWER_PASSWORD=
DEMO_AGENCY_EMAIL=
DEMO_AGENCY_PASSWORD=
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
